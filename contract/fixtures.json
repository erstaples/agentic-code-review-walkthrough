{
  "kanko_tour_status": {
    "requests": [
      {
        "query": {
          "protocolVersion": 3
        },
        "body": {}
      }
    ],
    "responses": [
      {
        "ok": true,
        "protocolVersion": 3,
        "extensionVersion": "0.1.0",
        "ideName": "Visual Studio Code",
        "workspaceFolders": [
          "/repo"
        ],
        "snapshot": {
          "loaded": false,
          "revision": 0
        }
      },
      {
        "ok": false,
        "error": {
          "code": "unauthorized",
          "message": "missing or invalid bearer token"
        }
      }
    ]
  },
  "kanko_tour_clear": {
    "requests": [
      {
        "body": {
          "protocolVersion": 3
        }
      }
    ],
    "responses": [
      {
        "ok": true
      }
    ]
  },
  "kanko_tour_load": {
    "requests": [
      {
        "method": "POST",
        "path": "/tour/load",
        "body": {
          "protocolVersion": 3,
          "workspace": "/repo",
          "tourId": "record",
          "plan": {
            "presentationVersion": 2,
            "stops": []
          }
        }
      }
    ],
    "responses": [
      {
        "ok": false,
        "error": {
          "code": "invalid_tour_plan",
          "message": "Fix tour validation findings before loading."
        }
      }
    ]
  },
  "kanko_tour_navigate": {
    "requests": [
      {
        "method": "POST",
        "path": "/tour/navigate",
        "body": {
          "protocolVersion": 3,
          "workspace": "/repo",
          "action": "nextBeat"
        }
      }
    ],
    "responses": [
      {
        "ok": false,
        "error": {
          "code": "no_tour",
          "message": "Load a tour first."
        }
      }
    ]
  },
  "kanko_tour_set_state": {
    "requests": [
      {
        "method": "POST",
        "path": "/tour/state",
        "body": {
          "protocolVersion": 3,
          "workspace": "/repo",
          "mode": "exploring"
        }
      }
    ],
    "responses": [
      {
        "ok": false,
        "error": {
          "code": "no_tour",
          "message": "Load a tour first."
        }
      }
    ]
  }
}
