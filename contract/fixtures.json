{
  "tour_status": {
    "requests": [
      {
        "query": {
          "protocolVersion": 2
        },
        "body": {}
      }
    ],
    "responses": [
      {
        "ok": true,
        "protocolVersion": 2,
        "extensionVersion": "0.1.0",
        "ideName": "Visual Studio Code",
        "workspaceFolders": [
          "/repo"
        ],
        "snapshot": {
          "loaded": false,
          "revision": 0
        }
      },
      {
        "ok": false,
        "error": {
          "code": "unauthorized",
          "message": "missing or invalid bearer token"
        }
      }
    ]
  },
  "tour_clear": {
    "requests": [
      {
        "body": {
          "protocolVersion": 2
        }
      }
    ],
    "responses": [
      {
        "ok": true
      }
    ]
  },
  "relay_load_tour": {
    "requests": [
      {
        "method": "POST",
        "path": "/tour/load",
        "body": {
          "protocolVersion": 2,
          "workspace": "/repo",
          "tourId": "dossier",
          "plan": {
            "presentationVersion": 2,
            "stops": []
          }
        }
      }
    ],
    "responses": [
      {
        "ok": false,
        "error": {
          "code": "invalid_tour_plan",
          "message": "Fix tour validation findings before loading."
        }
      }
    ]
  },
  "relay_navigate": {
    "requests": [
      {
        "method": "POST",
        "path": "/tour/navigate",
        "body": {
          "protocolVersion": 2,
          "workspace": "/repo",
          "action": "nextBeat"
        }
      }
    ],
    "responses": [
      {
        "ok": false,
        "error": {
          "code": "no_tour",
          "message": "Load a tour first."
        }
      }
    ]
  },
  "relay_set_state": {
    "requests": [
      {
        "method": "POST",
        "path": "/tour/state",
        "body": {
          "protocolVersion": 2,
          "workspace": "/repo",
          "mode": "exploring"
        }
      }
    ],
    "responses": [
      {
        "ok": false,
        "error": {
          "code": "no_tour",
          "message": "Load a tour first."
        }
      }
    ]
  }
}
