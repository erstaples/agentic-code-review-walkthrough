{
  "name": "kanko",
  "displayName": "Kanko",
  "description": "Let your coding agent guide you through code changes with focused highlights, native diffs, and editor citations.",
  "version": "0.1.1",
  "publisher": "getkanko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getkanko/kanko.git",
    "directory": "editor-extension"
  },
  "engines": {
    "vscode": "^1.139.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "colors": [
      {
        "id": "relay.presenterRail",
        "description": "Tour presenter rail and overview ruler",
        "defaults": {
          "dark": "#A99BF5",
          "light": "#534AB7",
          "highContrast": "#C9BFFF",
          "highContrastLight": "#26215C"
        }
      },
      {
        "id": "relay.presenterFocus",
        "description": "Tour focus outline",
        "defaults": {
          "dark": "#A99BF5",
          "light": "#534AB7",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.presenterLabelBackground",
        "description": "Beat label background",
        "defaults": {
          "dark": "#3C3489",
          "light": "#EEEDFE",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.presenterLabelForeground",
        "description": "Beat label text",
        "defaults": {
          "dark": "#EEEDFE",
          "light": "#3C3489",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.presenterSeam",
        "description": "Marker where removed lines were",
        "defaults": {
          "dark": "#A99BF5",
          "light": "#534AB7",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.anchor1",
        "description": "Tour anchor 1 identity color",
        "defaults": {
          "dark": "#A99BF5",
          "light": "#6554B5",
          "highContrast": "#A99BF5",
          "highContrastLight": "#6554B5"
        }
      },
      {
        "id": "relay.anchor2",
        "description": "Tour anchor 2 identity color",
        "defaults": {
          "dark": "#68CCBC",
          "light": "#14786A",
          "highContrast": "#68CCBC",
          "highContrastLight": "#14786A"
        }
      },
      {
        "id": "relay.anchor3",
        "description": "Tour anchor 3 identity color",
        "defaults": {
          "dark": "#EBC26B",
          "light": "#936B10",
          "highContrast": "#EBC26B",
          "highContrastLight": "#936B10"
        }
      },
      {
        "id": "relay.anchor4",
        "description": "Tour anchor 4 identity color",
        "defaults": {
          "dark": "#F19382",
          "light": "#A13F2D",
          "highContrast": "#F19382",
          "highContrastLight": "#A13F2D"
        }
      },
      {
        "id": "relay.anchor5",
        "description": "Tour anchor 5 identity color",
        "defaults": {
          "dark": "#84B8F5",
          "light": "#366FAF",
          "highContrast": "#84B8F5",
          "highContrastLight": "#366FAF"
        }
      },
      {
        "id": "relay.anchor6",
        "description": "Tour anchor 6 identity color",
        "defaults": {
          "dark": "#E6A1CF",
          "light": "#95497C",
          "highContrast": "#E6A1CF",
          "highContrastLight": "#95497C"
        }
      },
      {
        "id": "relay.anchor1.labelBackground",
        "description": "Tour anchor 1 inline label background",
        "defaults": {
          "dark": "#A99BF5",
          "light": "#6554B5",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.anchor1.labelForeground",
        "description": "Tour anchor 1 inline label foreground",
        "defaults": {
          "dark": "#181818",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.anchor2.labelBackground",
        "description": "Tour anchor 2 inline label background",
        "defaults": {
          "dark": "#68CCBC",
          "light": "#14786A",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.anchor2.labelForeground",
        "description": "Tour anchor 2 inline label foreground",
        "defaults": {
          "dark": "#181818",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.anchor3.labelBackground",
        "description": "Tour anchor 3 inline label background",
        "defaults": {
          "dark": "#EBC26B",
          "light": "#936B10",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.anchor3.labelForeground",
        "description": "Tour anchor 3 inline label foreground",
        "defaults": {
          "dark": "#181818",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.anchor4.labelBackground",
        "description": "Tour anchor 4 inline label background",
        "defaults": {
          "dark": "#F19382",
          "light": "#A13F2D",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.anchor4.labelForeground",
        "description": "Tour anchor 4 inline label foreground",
        "defaults": {
          "dark": "#181818",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.anchor5.labelBackground",
        "description": "Tour anchor 5 inline label background",
        "defaults": {
          "dark": "#84B8F5",
          "light": "#366FAF",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.anchor5.labelForeground",
        "description": "Tour anchor 5 inline label foreground",
        "defaults": {
          "dark": "#181818",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "relay.anchor6.labelBackground",
        "description": "Tour anchor 6 inline label background",
        "defaults": {
          "dark": "#E6A1CF",
          "light": "#95497C",
          "highContrast": "#000000",
          "highContrastLight": "#FFFFFF"
        }
      },
      {
        "id": "relay.anchor6.labelForeground",
        "description": "Tour anchor 6 inline label foreground",
        "defaults": {
          "dark": "#181818",
          "light": "#FFFFFF",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ],
    "configuration": {
      "title": "kanko Presentation",
      "properties": {
        "relay.presentation.dimOpacity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1,
          "default": 0.45,
          "description": "Context text opacity while following; 1 disables dimming."
        },
        "relay.presentation.showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show inline beat labels."
        },
        "relay.tour.anchorLimit": {
          "type": "integer",
          "default": 24,
          "minimum": 1,
          "maximum": 99,
          "description": "Maximum anchors allowed per tour stop."
        },
        "relay.presentation.removedCode": {
          "type": "string",
          "enum": [
            "companion",
            "seam"
          ],
          "default": "companion",
          "description": "Show removed base focus beside an inline diff when there is room, or offer a seam with Peek removed code."
        }
      }
    },
    "commands": [
      {
        "command": "tourChanges.copyCitation",
        "title": "kanko: Copy Citation"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tourChanges.copyCitation",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == relay-rev)",
          "group": "tourChanges"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "relay",
          "title": "kanko",
          "icon": "assets/kanko-sidebar.svg"
        }
      ]
    },
    "views": {
      "relay": [
        {
          "id": "relay.tour",
          "name": "Tour",
          "type": "webview"
        }
      ]
    }
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.0.0"
  },
  "scripts": {
    "test:unit": "node --test 'test/*.test.js'",
    "test:integration": "node test/integration/runner.js",
    "package": "vsce package",
    "rebuild:vsix": "bash ../scripts/build-vsix.sh",
    "check:release": "node ../scripts/check-extension-release.js"
  },
  "homepage": "https://github.com/getkanko/kanko#readme",
  "bugs": {
    "url": "https://github.com/getkanko/kanko/issues"
  },
  "files": [
    "extension.js",
    "lib/**/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/kanko-icon-256.png",
    "media/*",
    "assets/kanko-sidebar.svg"
  ],
  "icon": "assets/kanko-icon-256.png",
  "galleryBanner": {
    "color": "#2E2873",
    "theme": "dark"
  }
}
