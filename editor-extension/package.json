  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/vscode": "1.138.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test:unit": "npm run build:test && node --test test/*.test.js",
    "test:integration": "node test/integration/runner.js",
    "package": "vsce package",
    "rebuild:vsix": "bash ../scripts/build-vsix.sh",
    "check:release": "node ../scripts/check-extension-release.js",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.host.json && tsc -p tsconfig.webview.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"tsconfig*.json\"",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"tsconfig*.json\"",
    "build:test": "node scripts/build.mjs --test",
    "test:all": "npm run build:test && node --test ../test/*.test.js ../mcp/test/*.test.js test/*.test.js",
    "vscode:prepublish": "npm run typecheck && npm run format:check && npm run build"
  },
  "homepage": "https://github.com/getkanko/kanko#readme",
  "bugs": {
    "url": "https://github.com/getkanko/kanko/issues"
  },
