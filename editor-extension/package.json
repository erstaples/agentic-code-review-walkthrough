    "configuration": {
      "title": "Kank\u014d Presentation",
      "properties": {
        "kanko.presentation.dimOpacity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1,
          "default": 0.45,
          "description": "Context text opacity while following; 1 disables dimming."
        },
        "kanko.presentation.showLabels": {
          "type": "boolean",
          "default": true,
          "description": "Show inline beat labels."
        },
        "kanko.tour.anchorLimit": {
          "type": "integer",
          "default": 24,
          "minimum": 1,
          "maximum": 99,
          "description": "Maximum anchors allowed per tour stop."
        },
        "kanko.presentation.removedCode": {
          "type": "string",
          "enum": [
            "companion",
            "seam"
          ],
          "default": "companion",
          "description": "Show removed base focus beside an inline diff when there is room, or offer a seam with Peek removed code."
        },
        "kanko.layout.maxGroups": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4,
          "default": 3,
          "description": "Maximum editor groups the tour may create. Existing reviewer groups are preserved."
        },
        "kanko.layout.orientation": {
          "type": "string",
          "enum": [
            "auto",
            "stacked",
            "columns"
          ],
          "default": "auto",
          "description": "Two-group layout. Auto stacks side-by-side diffs and uses columns for single-file views; three and four groups use split rows."
        },
        "kanko.layout.sequenceFallback": {
          "type": "boolean",
          "default": true,
          "description": "Use one editor group when an untouched tour layout shows fewer than 18 lines. The tour also offers a per-stop override."
        }
      }
    },
    "commands": [
      {
        "command": "kanko.copyCitation",
        "title": "Kank\u014d: Copy Citation"
      },
      {
        "command": "kanko.tour.pinActive",
        "title": "Kank\u014d: Toggle Pin on Active Tour Anchor"
      },
      {
        "command": "kanko.tour.overrideSequence",
        "title": "Kank\u014d: Show Multiple Groups for This Stop"
      },
      {
        "command": "kanko.tour.quickPick",
        "title": "Kank\u014d: Find File in Stop"
      },
      {
        "command": "kanko.tour.resetLayout",
        "title": "Kank\u014d: Reset Stop Layout"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kanko.copyCitation",
          "when": "editorHasSelection && (resourceScheme == file || resourceScheme == kanko-rev)",
          "group": "kanko"
        }
      ]
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "kanko",
          "title": "Kank\u014d",
          "icon": "assets/kanko-sidebar.svg"
        }
      ]
    },
    "views": {
      "kanko": [
        {
          "id": "kanko.tour",
          "name": "Tour",
          "type": "webview"
        }
      ]
    },
    "keybindings": [
