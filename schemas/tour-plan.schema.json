{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getkanko.dev/kanko/schemas/tour-plan.schema.json",
  "title": "Kankō v2 tour presentation",
  "type": "object",
  "required": ["presentationVersion", "stops"],
  "properties": {
    "presentationVersion": { "const": 2 },
    "title": { "type": "string", "minLength": 1 },
    "stops": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stop" } }
  },
  "$defs": {
    "range": {
      "type": "object", "required": ["startLine", "endLine"],
      "properties": { "startLine": { "type": "integer", "minimum": 1 }, "endLine": { "type": "integer", "minimum": 1 } }
    },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "focus": {
      "type": "object", "required": ["side", "range"],
      "properties": {
        "side": { "enum": ["base", "head"] }, "range": { "$ref": "#/$defs/range" },
        "kind": { "enum": ["added", "removed", "unchanged"] }, "contentHash": { "$ref": "#/$defs/hash" }
      }
    },
    "anchor": {
      "type": "object", "required": ["n", "role", "label", "path", "view", "change", "rev", "context", "contentHash"],
      "properties": {
        "n": { "type": "integer", "minimum": 1, "maximum": 99 },
        "role": { "enum": ["change", "evidence", "callee", "caller", "config", "schema", "context"] },
        "label": { "type": "string", "minLength": 1, "description": "At most five words." },
        "path": { "type": "string", "minLength": 1, "description": "Repository-relative path; for a rename use the head path." },
        "view": { "enum": ["diff", "head", "base"] },
        "side": { "enum": ["base", "head"], "description": "Context coordinate side. Defaults to base for base view or deletion; head otherwise." },
        "change": { "enum": ["modified", "added", "deleted", "unchanged"] },
        "rev": {
          "type": "object", "required": ["base", "head"],
          "properties": { "base": { "type": "string", "minLength": 1 }, "head": { "type": "string", "minLength": 1 } }
        },
        "context": { "$ref": "#/$defs/range" },
        "focus": { "type": "array", "items": { "$ref": "#/$defs/focus" } },
        "symbol": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/hash" },
        "claimRefs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Claims demonstrated by an evidence-role anchor." }
      }
    },
    "beat": {
      "type": "object", "required": ["id", "narration", "active"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "narration": { "type": "string", "minLength": 1, "description": "Markdown; use {{a:N}} for every file reference." },
        "active": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 99 }, "description": "Anchor numbers in display priority order." }
      }
    },
    "stop": {
      "type": "object", "required": ["id", "title", "risk", "anchors", "beats"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["low", "medium", "high"] },
        "type": { "type": "string", "description": "Review map coverage category; context stops may omit coveredEntityIds." },
        "coveredEntityIds": { "type": "array", "items": { "type": "string" } },
        "anchors": { "type": "array", "minItems": 1, "maxItems": 99, "items": { "$ref": "#/$defs/anchor" } },
        "beats": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/beat" } }
      }
    }
  }
}
