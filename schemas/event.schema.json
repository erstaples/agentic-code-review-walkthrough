{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getkanko.dev/kanko/schemas/event.schema.json",
  "title": "Living change dossier event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dossierId", "sequence", "eventId", "eventType", "occurredAt", "actor", "changeRevisionId", "expectedAggregateRevision", "payload", "previousEventHash", "eventHash"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dossierId": { "type": "string", "pattern": "^dos_[0-9a-f-]+$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "eventId": { "type": "string", "pattern": "^evt_[0-9a-f-]+$" },
    "eventType": { "type": "string", "minLength": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "actor": { "type": "object", "required": ["kind", "id"] },
    "changeRevisionId": { "type": ["string", "null"] },
    "expectedAggregateRevision": { "type": "integer", "minimum": 0 },
    "payload": { "type": "object" },
    "previousEventHash": { "type": ["string", "null"] },
    "eventHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
